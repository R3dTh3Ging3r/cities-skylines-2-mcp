  "representativeSchemas": {
    "cs2_set_simulation": {
      "type": "object",
      "properties": {
        "paused": {
          "type": "boolean",
          "description": "true to pause, false to resume"
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 8,
          "description": "simulation speed multiplier (0-8)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "cs2_screenshot": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 3840,
          "description": "Downscale the image to this width in pixels (default 1280, keeps aspect ratio)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "cs2_place_building": {
      "type": "object",
      "properties": {
        "prefab": {
          "type": "string",
          "description": "Exact prefab name from cs2_find_prefabs"
        },
        "x": {
          "type": "number",
          "description": "World X coordinate (meters)"
        },
        "z": {
          "type": "number",
          "description": "World Z coordinate (meters)"
        },
        "rotation": {
          "type": "number",
          "description": "Rotation around Y axis in degrees (default 0)"
        },
        "force": {
          "type": "boolean",
          "description": "Place even if the prefab is milestone-locked"
        }
      },
      "required": [
        "prefab",
        "x",
        "z"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "cs2_terrain": {
      "type": "object",
      "properties": {
        "resolution": {
          "type": "integer",
          "minimum": 16,
          "maximum": 256,
          "description": "Grid resolution per axis (default 64)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "cs2_save_game": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Save name (default: timestamped)"
        }
      },
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "cs2_create_transit_line": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "bus",
            "tram",
            "metro",
            "train"
          ],
          "description": "Transport type"
        },
        "stops": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "index": {
                    "type": "integer"
                  },
                  "version": {
                    "type": "integer"
                  }
                },
                "required": [
                  "index",
                  "version"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  }
                },
                "required": [
                  "x",
                  "z"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 2,
          "maxItems": 100,
          "description": "Ordered stops (at least 2 different ones)"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "description": "Custom line name (default: the game's 'Bus Line N')"
        },
        "color": {
          "type": "string",
          "pattern": "^#?[0-9a-fA-F]{6}$",
          "description": "Line color as #RRGGBB (default: the game's color for this line type)"
        },
        "snapRadius": {
          "type": "number",
          "minimum": 5,
          "maximum": 300,
          "description": "Max distance for {x, z} stops to snap (default 60m)"
        },
        "force": {
          "type": "boolean",
          "description": "Create even if this line type is milestone-locked"
        }
      },
      "required": [
        "type",
        "stops"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "cs2_replace_road": {
      "type": "object",
      "properties": {
        "roads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer"
              },
              "version": {
                "type": "integer"
              }
            },
            "required": [
              "index",
              "version"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 50,
          "description": "Road segments to replace (from cs2_list_roads or cs2_traffic)"
        },
        "prefab": {
          "type": "string",
          "description": "New road prefab name (cs2_find_prefabs category road)"
        },
        "invert": {
          "type": "boolean",
          "description": "Flip the drawing direction (one-way roads then run the other way)"
        },
        "force": {
          "type": "boolean",
          "description": "Use the prefab even if it is milestone-locked"
        }
      },
      "required": [
        "roads",
        "prefab"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  }
}
