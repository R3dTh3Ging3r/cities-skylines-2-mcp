<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GamePath Condition="'$(GamePath)' == '' And '$(CS2_PATH)' != ''">$(CS2_PATH)</GamePath>
    <GamePath Condition="'$(GamePath)' == '' And '$(CSII_INSTALLATIONPATH)' != ''">$(CSII_INSTALLATIONPATH)</GamePath>
    <NewtonsoftPath Condition="'$(NewtonsoftPath)' == '' And '$(GamePath)' != ''">$(GamePath)/Cities2_Data/Managed/Newtonsoft.Json.dll</NewtonsoftPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Existing runtime serializer only: no Game/Unity/ECS assembly or new package. -->
    <Reference Include="Newtonsoft.Json"><HintPath>$(NewtonsoftPath)</HintPath></Reference>
    <Compile Include="Program.cs" />
    <Compile Include="../../CS2MCP.Bridge/BridgeRequest.cs" Link="BridgeRequest.cs" />
    <Compile Include="../../CS2MCP.Bridge/Core/Contracts.cs" Link="Core/Contracts.cs" />
    <Compile Include="../../CS2MCP.Bridge/Core/ErrorCodes.cs" Link="Core/ErrorCodes.cs" />
  </ItemGroup>
  <Target Name="ValidateSerializerPath" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(NewtonsoftPath)')" Text="Pass -p:NewtonsoftPath=path/to/existing/runtime/Newtonsoft.Json.dll" />
  </Target>
</Project>
